# Application
APP_ENV=development
APP_URL=http://localhost:3000
STORE_MODE=commerce
# Production release preflight requires an active monitoring recipient, managed
# backup retention, and evidence of one successful isolated restore exercise.
MONITORING_OWNER=
BACKUP_PROVIDER=
BACKUP_RETENTION_DAYS=
LAST_RESTORE_TEST_AT=
# Optional Google Search Console HTML verification token.
GOOGLE_SITE_VERIFICATION=

# Demo safeguards
DEPLOYMENT_MODE=local
DEMO_MODE=true
DEMO_RESET_SECRET=replace-with-a-long-random-value
# On the isolated portfolio deployment only, set this to the exact same value
# as DATABASE_URL. Customer deployments must leave it empty.
DEMO_DATABASE_URL=

# Email is intentionally local for the portfolio demo.
EMAIL_PROVIDER=demo_outbox
ADMIN_NOTIFICATION_EMAIL=admin@demo.threadd.store
# Optional. International format without +, for example 2348012345678.
WHATSAPP_PHONE_NUMBER=

# Added in Phase 2.
DATABASE_URL=postgresql://user:password@localhost:5432/threadd
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000

# Production-only, one-time server CLI bootstrap. Keep disabled normally.
ALLOW_SUPER_ADMIN_BOOTSTRAP=false
SUPER_ADMIN_NAME=THREADD Owner
SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_PASSWORD=replace-with-a-strong-unique-password

# Added in Phase 7. Use test credentials in the public demo.
PAYSTACK_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_replace_me

# OPay Cashier is shown at checkout only when all three credentials are set.
OPAY_ENABLED=false
OPAY_ENVIRONMENT=test
OPAY_MERCHANT_ID=replace-with-opay-merchant-id
OPAY_PUBLIC_KEY=replace-with-opay-public-key
OPAY_SECRET_KEY=replace-with-opay-private-key


# Local storage is restricted to development and the disposable portfolio demo.
# Customer deployments use the server-only Cloudinary adapter.
MEDIA_STORAGE_PROVIDER=local_demo
# Required only when MEDIA_STORAGE_PROVIDER=cloudinary. Use a separate folder
# per deployment, for example threadd/customer-production.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=